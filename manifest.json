{
  "manifest_version": 3,
  "name": "VulnChecker",
  "version": "1.0.0",
  "description": "Audit the security, privacy, legal and quality posture of a website you own — one click, plain-English report.",
  "author": "Oleg Narainen",
  "permissions": ["activeTab", "scripting", "webRequest", "storage", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "VulnChecker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
